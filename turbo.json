{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "APP_DB_PASSWORD",
        "OUTBOX_DB_PASSWORD",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "SMTP_HOST"
      ]
    }
  }
}
