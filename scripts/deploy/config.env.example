# Copy to scripts/deploy/config.env (gitignored) and fill in your values.
# Sourced by every script in scripts/deploy/ - nothing here is a secret,
# it's just environment-specific addressing (see infra/terraform/main
# outputs for the instance IP / hostname).

AWS_REGION="us-east-1"
AWS_PROFILE="commerce-os-deploy"          # local IAM user profile in ~/.aws/credentials
ARTIFACTS_BUCKET="commerce-os-artifacts-CHANGE-ME"

INSTANCE_HOST="203.0.113.4.sslip.io"      # Elastic IP's sslip.io hostname (terraform output app_hostname)
SSH_USER="ec2-user"
SSH_KEY_PATH="$HOME/.ssh/commerce-os-deploy.pem"

BACKEND_IMAGE="commerce-os-backend"
WEB_IMAGE="commerce-os-web"

REMOTE_APP_DIR="/opt/commerce-os/app"
REMOTE_RELEASES_DIR="/opt/commerce-os/releases"

MAX_S3_BUILDS=5
LOCAL_RELEASES_KEPT_ON_INSTANCE=2

ROUNDTRIP_TIMEOUT_SECONDS=90
