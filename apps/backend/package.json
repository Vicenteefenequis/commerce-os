{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "worker:dev": "tsx watch src/worker/outbox-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http/server.js",
    "worker:start": "node dist/worker/outbox-worker.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up -m migrations -j cjs --envPath ../../.env",
    "migrate:down": "node-pg-migrate down -m migrations -j cjs --envPath ../../.env"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
