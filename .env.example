# Used by node-pg-migrate for local (non-docker) migrations - the
# privileged/owner role that can create tables, roles, and RLS policies.
# In docker-compose, backend/outbox-worker instead connect as the
# non-superuser `app_user` role (see docker-compose.yml) so Row Level
# Security is actually enforced - superusers always bypass RLS.
DATABASE_URL=postgres://commerce_os:commerce_os@localhost:5432/commerce_os
NODE_ENV=development
PORT=4000
SESSION_COOKIE_NAME=cos_session
SESSION_TTL_SECONDS=604800

# apps/web
BACKEND_URL=http://localhost:4000

# docker-compose only
POSTGRES_USER=commerce_os
POSTGRES_PASSWORD=commerce_os
POSTGRES_DB=commerce_os
# Password for the non-superuser app_user role created by migrations,
# used by backend in docker-compose.
APP_DB_PASSWORD=commerce_os_app
# Password for the non-superuser outbox_worker_user role (needs
# cross-tenant SELECT on outbox_events only), used by outbox-worker.
OUTBOX_DB_PASSWORD=commerce_os_outbox
