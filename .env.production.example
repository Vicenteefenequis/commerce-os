# Copy to /opt/commerce-os/app/.env on the instance (never commit the real
# file - it's covered by .gitignore). docker-compose.prod.yml reads it
# automatically because docker compose loads `.env` from its own directory.

POSTGRES_USER=commerce_os
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=commerce_os
APP_DB_PASSWORD=CHANGE_ME
OUTBOX_DB_PASSWORD=CHANGE_ME

SESSION_COOKIE_NAME=cos_session
SESSION_TTL_SECONDS=604800

STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=no-reply@yourdomain.example

# Set by scripts/deploy/deploy.sh before each `docker compose up`, not by hand.
RELEASE_SHA=
